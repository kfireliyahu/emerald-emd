{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "demo-tour",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:demo",
        "--",
        "--port",
        "4181",
        "--strictPort"
      ],
      "port": 4181
    },
    {
      "name": "demo-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "dist-demo"
      ],
      "port": 4180
    },
    {
      "name": "demo-embed",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4182",
        "--bind",
        "localhost",
        "--directory",
        "docs/mockups/m33-u4"
      ],
      "port": 4182
    },
    {
      "name": "frame-try",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4183",
