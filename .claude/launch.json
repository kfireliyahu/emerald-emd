      ],
      "port": 4184
    },
    {
      "name": "frame-live-roadmap",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/try-frame.mjs",
        "docs/memory.emd",
        "milestone",
        "--view=roadmap",
        "--live",
        "--no-open",
        "--port=4186"
      ],
      "port": 4186
    },
    {
      "name": "frame-live-check",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/try-frame.mjs",
        "docs/memory.emd",
        "open_question",
        "--live",
        "--no-push",
        "--no-open",
        "--port=4185"
      ],
      "port": 4185
    },
    {
      "name": "frame-live-vscode",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/try-frame.mjs",
        "docs/memory.emd",
        "milestone",
        "--view=roadmap",
        "--live",
        "--no-open",
        "--port=4187",
